<div class="weather-landing">
  <section class="weather-hero">
    <p class="weather-hero__badge">Nominatim + WeatherAPI.com</p>
    <h1>Check the latest conditions in seconds</h1>
    <p class="weather-hero__lead">
      Search a city, landmark, region, postal code, or coordinates. A postal code is optional — places without one still resolve to a forecast.
    </p>

    <ul class="weather-hero__highlights">
      <li>Identical searches are served from a shared cache for 30 minutes</li>
      <li>Temperature available in Celsius and Fahrenheit</li>
      <li>Includes wind, visibility, UV index, and precipitation</li>
    </ul>
  </section>

  <section class="weather-form-card">
    <h2>Search by address</h2>
    <p class="weather-form-card__hint">Try “Eiffel Tower”, “São Paulo”, “94105”, or “-23.55, -46.63”. Postal codes are not required.</p>

    <%= form_with url: weather_forecast_path, method: :get, data: { controller: "weather-form", action: "submit->weather-form#validate", turbo: false }, html: { class: "zip-form" } do |form| %>
      <div class="zip-form__group">
        <%= form.label :address, "Address", class: "zip-form__label" %>
        <div class="zip-form__input-wrap zip-form__input-wrap--text">
          <%= form.text_field :address,
                              placeholder: "City, landmark, region, or coordinates",
                              value: @address_query.address,
                              maxlength: AddressQuery::MAX_LENGTH,
                              size: 40,
                              class: "zip-form__input zip-form__input--text",
                              data: { "weather-form-target": "address", action: "input->weather-form#onInput" } %>
          <button type="submit" class="zip-form__submit">Check weather</button>
        </div>
      </div>

      <div class="zip-form__group">
        <span class="zip-form__label">Forecast day (up to 5 days)</span>
        <% selected_offset = @address_query.days_from_now %>
        <div class="zip-form__calendar" data-weather-form-target="dayList">
          <% 0.upto(5) do |offset| %>
            <% date = Time.zone.today + offset.days %>
            <% caption = case offset
                        when 0 then "Today"
                        when 1 then "Tomorrow"
                        else "#{offset} days ahead"
                        end %>
            <label class="zip-form__day-option <%= "zip-form__day-option--selected" if selected_offset == offset %>" data-weather-form-target="dayOption">
              <%= form.radio_button :days_from_now, offset, checked: selected_offset == offset, class: "zip-form__day-input", data: { action: "change->weather-form#selectDay" } %>
              <span class="zip-form__day-date"><%= date.strftime("%b %d") %></span>
              <span class="zip-form__day-caption"><%= caption %></span>
            </label>
          <% end %>
        </div>
      </div>

      <p class="zip-form__notice">The address is sent to OpenStreetMap Nominatim and WeatherAPI.com. Forecasts are cached for 30 minutes and are not stored in a database.</p>
    <% end %>
  </section>
</div>
