<div class="weather-forecast">
  <% if flash[:alert] %>
    <p class="alert"><%= flash[:alert] %></p>
  <% end %>

  <% if @forecast.present? %>
    <%= render partial: "weather/weather_api_com_partial", locals: { forecast: @forecast } %>
  <% elsif flash[:alert].blank? %>
    <p class="alert">No forecast data was returned for the provided location.</p>
  <% end %>

  <% unless @forecast.present? %>
    <p class="weather-forecast__back">
      <%= link_to "← Back to search", weather_path, class: "weather-card__back" %>
    </p>
  <% end %>
</div>

